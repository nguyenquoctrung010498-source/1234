  function calcCosts() {
    const hh_rate = 0.05 * 2616000;
    const base = 1000000;
    let grandTotal = 0;
    [1,2,3].forEach(function(i) {
      var n = parseInt(document.getElementById('cn'+i).value);
      document.getElementById('cv'+i).textContent = n;
      var hh = Math.min(hh_rate, 200000) * n;
      var total = base + hh;
      grandTotal += total;
      document.getElementById('chh'+i).textContent = hh.toLocaleString('vi-VN') + 'đ';
      document.getElementById('ct'+i).textContent = total.toLocaleString('vi-VN') + 'đ';
      document.getElementById('ccpn'+i).textContent = n > 0 ? Math.round(total/n).toLocaleString('vi-VN') + 'đ' : '—';
    });
    document.getElementById('ctotal').textContent = grandTotal.toLocaleString('vi-VN') + 'đ';
  }
  calcCosts();
  </script>

