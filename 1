<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Quy trình CTV Tuyển dụng — Phòng Lao Động HEZA</title>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Archivo+Black&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #f5f6f8;
  --bg2: #ffffff;
  --bg3: #f0f2f5;
  --border: rgba(0,0,0,0.08);
  --border2: rgba(0,0,0,0.16);
  --text: #1a1d23;
  --text2: #4b5263;
  --text3: #8a92a3;
  --teal: #0f8a62;
  --teal-light: #0b7a56;
  --teal-dim: rgba(15,138,98,0.10);
  --purple: #5b4fd4;
  --purple-dim: rgba(91,79,212,0.10);
  --amber: #a06b00;
  --amber-dim: rgba(160,107,0,0.10);
  --coral: #b84420;
  --coral-dim: rgba(184,68,32,0.10);
  --gray-dim: rgba(0,0,0,0.04);
  --radius: 10px;
  --radius-lg: 16px;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: 'Be Vietnam Pro', sans-serif;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  font-size: 14px;
  line-height: 1.6;
}

/* HEADER */
.header {
  background: var(--bg2);
  border-bottom: 1px solid var(--border);
  padding: 0 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 56px;
  position: sticky;
  top: 0;
  z-index: 100;
}
.header-brand {
  display: flex;
  align-items: center;
  gap: 12px;
}
.header-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: #0f8a62;
  box-shadow: 0 0 6px rgba(15,138,98,0.5);
  animation: pulse 2s ease-in-out infinite;
}
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.4} }
.header-title {
  font-family: 'Archivo Black', sans-serif;
  font-size: 15px;
  letter-spacing: 0.02em;
  color: var(--text);
}
.header-sub { font-size: 11px; color: var(--text3); margin-top: 1px; }
.header-tabs {
  display: flex;
  gap: 4px;
}
.tab-btn {
  padding: 6px 14px;
  border-radius: 6px;
  border: 1px solid transparent;
  background: transparent;
  color: var(--text2);
  font-family: 'Be Vietnam Pro', sans-serif;
  font-size: 13px;
  cursor: pointer;
  transition: all .2s;
  white-space: nowrap;
}
.tab-btn:hover { background: var(--bg3); color: var(--text); }
.tab-btn.active {
  background: var(--teal-dim);
  border-color: var(--teal);
  color: #0b7a56;
}

/* LAYOUT */
.container { max-width: 1100px; margin: 0 auto; padding: 28px 20px; }
.section { display: none; }
.section.active { display: block; }

/* TỔNG QUAN — PIPELINE */
.pipeline-header {
  text-align: center;
  margin-bottom: 36px;
}
.pipeline-header h2 {
  font-family: 'Archivo Black', sans-serif;
  font-size: 22px;
  color: var(--text);
  margin-bottom: 6px;
}
.pipeline-header p { color: var(--text2); font-size: 13px; }

.pipeline {
  display: flex;
  flex-direction: column;
  gap: 0;
  position: relative;
}
.phase {
  display: grid;
  grid-template-columns: 180px 1fr;
  gap: 0;
  position: relative;
}
.phase-connector {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.phase-num {
  width: 36px; height: 36px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-family: 'Archivo Black', sans-serif;
  font-size: 13px;
  flex-shrink: 0;
  border: 1.5px solid;
  transition: all .3s;
  cursor: pointer;
}
.phase-num:hover { transform: scale(1.1); }
.phase-line {
  flex: 1;
  width: 1.5px;
  background: var(--border);
  min-height: 60px;
}
.phase-label {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding: 4px 0 4px 20px;
}
.phase-label-title {
  font-size: 11px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text3);
  margin-bottom: 4px;
}
.phase-card {
  background: var(--bg2);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 18px 20px;
  margin-bottom: 12px;
  cursor: pointer;
  transition: all .25s;
  position: relative;
  overflow: hidden;
}
.phase-card::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 3px;
  border-radius: 3px 0 0 3px;
}
.phase-card:hover {
  border-color: var(--border2);
  transform: translateX(4px);
}
.phase-card h3 {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 6px;
}
.phase-card p { color: var(--text2); font-size: 13px; }
.phase-steps {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 10px;
}
.step-chip {
  padding: 3px 10px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 500;
  border: 1px solid;
}
/* Color variants */
.v-teal .phase-num { color: #0b7a56; border-color: var(--teal); background: var(--teal-dim); }
.v-teal .phase-card::before { background: var(--teal); }
.v-teal .phase-card:hover { border-color: var(--teal); }
.v-teal .phase-card h3 { color: #0b7a56; }
.v-teal .step-chip { background: var(--teal-dim); border-color: var(--teal); color: #0b7a56; }

.v-purple .phase-num { color: var(--purple); border-color: var(--purple); background: var(--purple-dim); }
.v-purple .phase-card::before { background: var(--purple); }
.v-purple .phase-card:hover { border-color: var(--purple); }
.v-purple .phase-card h3 { color: #4a3fc0; }
.v-purple .step-chip { background: var(--purple-dim); border-color: var(--purple); color: #4a3fc0; }

.v-amber .phase-num { color: var(--amber); border-color: var(--amber); background: var(--amber-dim); }
.v-amber .phase-card::before { background: var(--amber); }
.v-amber .phase-card:hover { border-color: var(--amber); }
.v-amber .phase-card h3 { color: #8a5c00; }
.v-amber .step-chip { background: var(--amber-dim); border-color: var(--amber); color: #8a5c00; }

.v-coral .phase-num { color: var(--coral); border-color: var(--coral); background: var(--coral-dim); }
.v-coral .phase-card::before { background: var(--coral); }
.v-coral .phase-card:hover { border-color: var(--coral); }
.v-coral .phase-card h3 { color: #a03a18; }
.v-coral .step-chip { background: var(--coral-dim); border-color: var(--coral); color: #a03a18; }

/* CTV NHÓM */
.group-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-bottom: 28px;
}
.group-card {
  background: var(--bg2);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 20px;
  cursor: pointer;
  transition: all .25s;
}
.group-card:hover { border-color: var(--border2); transform: translateY(-2px); }
.group-card.selected { border-color: var(--teal); background: var(--teal-dim); }
.group-icon {
  width: 40px; height: 40px;
  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-size: 18px;
  margin-bottom: 12px;
}
.group-card h3 { font-size: 14px; font-weight: 600; margin-bottom: 4px; }
.group-card p { font-size: 12px; color: var(--text2); }
.group-badge {
  display: inline-block;
  margin-top: 10px;
  padding: 2px 8px;
  border-radius: 12px;
  font-size: 11px;
  font-weight: 500;
}

/* CHI TIẾT NHÓM */
.detail-panel {
  background: var(--bg2);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
}
.detail-tabs {
  display: flex;
  border-bottom: 1px solid var(--border);
  overflow-x: auto;
}
.detail-tab {
  padding: 12px 18px;
  font-size: 13px;
  color: var(--text2);
  cursor: pointer;
  border-bottom: 2px solid transparent;
  white-space: nowrap;
  transition: all .2s;
  background: transparent;
  border-top: none;
  border-left: none;
  border-right: none;
  font-family: 'Be Vietnam Pro', sans-serif;
}
.detail-tab:hover { color: var(--text); }
.detail-tab.active { color: #0b7a56; border-bottom-color: var(--teal); }
.detail-content { padding: 20px; display: none; }
.detail-content.active { display: block; }

/* INFO ROWS */
.info-section { margin-bottom: 20px; }
.info-section-title {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--text3);
  margin-bottom: 10px;
}
.info-row {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 8px 0;
  border-bottom: 1px solid var(--border);
}
.info-row:last-child { border-bottom: none; }
.info-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--teal);
  margin-top: 6px;
  flex-shrink: 0;
}
.info-row span { font-size: 13px; color: var(--text2); }
.info-row span strong { color: var(--text); font-weight: 500; }

/* CHI PHÍ TABLE */
.cost-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  margin-bottom: 16px;
}
.cost-card {
  background: var(--bg3);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 16px;
}
.cost-card .label { font-size: 11px; color: var(--text3); margin-bottom: 4px; }
.cost-card .value { font-size: 18px; font-weight: 700; color: #0b7a56; }
.cost-card .sub { font-size: 11px; color: var(--text2); margin-top: 4px; }

/* NGHIỆM THU */
.checklist { list-style: none; }
.checklist li {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 10px 0;
  border-bottom: 1px solid var(--border);
  font-size: 13px;
  color: var(--text2);
}
.checklist li:last-child { border-bottom: none; }
.check-icon {
  width: 18px; height: 18px;
  border-radius: 50%;
  background: var(--teal-dim);
  border: 1px solid var(--teal);
  display: flex; align-items: center; justify-content: center;
  font-size: 10px;
  color: #0b7a56;
  flex-shrink: 0;
  margin-top: 1px;
}

/* TIMELINE CHI TRẢ */
.timeline { position: relative; padding-left: 24px; }
.timeline::before {
  content: '';
  position: absolute;
  left: 7px; top: 8px; bottom: 8px;
  width: 1.5px;
  background: var(--border);
}
.tl-item {
  position: relative;
  margin-bottom: 16px;
  padding-bottom: 4px;
}
.tl-dot {
  position: absolute;
  left: -20px; top: 4px;
  width: 12px; height: 12px;
  border-radius: 50%;
  background: var(--teal);
  border: 2px solid var(--bg2);
}
.tl-day { font-size: 11px; color: #0b7a56; font-weight: 600; margin-bottom: 2px; }
.tl-text { font-size: 13px; color: var(--text2); }
.tl-text strong { color: var(--text); font-weight: 500; }

/* KPI */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
}
.kpi-item {
  background: var(--bg3);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 14px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.kpi-label { font-size: 12px; color: var(--text2); }
.kpi-value { font-size: 13px; font-weight: 600; color: #8a5c00; }

/* CÔNG CỤ */
.tools-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}
.tool-card {
  background: var(--bg3);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 16px;
}
.tool-card h4 { font-size: 13px; font-weight: 600; margin-bottom: 8px; color: var(--text); }
.tool-card p { font-size: 12px; color: var(--text2); line-height: 1.5; }
.tool-tag {
  display: inline-block;
  margin-top: 8px;
  padding: 2px 8px;
  border-radius: 10px;
  font-size: 10px;
  font-weight: 600;
  background: var(--purple-dim);
  border: 1px solid var(--purple);
  color: #4a3fc0;
}

/* MODAL */
.modal-overlay {
  display: none;
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.7);
  z-index: 200;
  align-items: center;
  justify-content: center;
  padding: 20px;
}
.modal-overlay.open { display: flex; }
.modal {
  background: var(--bg2);
  border: 1px solid var(--border2);
  border-radius: var(--radius-lg);
  width: 100%;
  max-width: 560px;
  max-height: 80vh;
  overflow-y: auto;
  padding: 24px;
}
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20px;
}
.modal-title { font-size: 16px; font-weight: 600; }
.modal-close {
  background: var(--bg3);
  border: 1px solid var(--border);
  color: var(--text2);
  width: 28px; height: 28px;
  border-radius: 6px;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  font-size: 16px;
  flex-shrink: 0;
}
.modal-close:hover { color: var(--text); border-color: var(--border2); }

/* SECTION DIVIDER */
.section-label {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--text3);
  margin: 28px 0 16px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.section-label::after {
  content: '';
  flex: 1;
  height: 1px;
  background: var(--border);
}

/* RESPONSIVE */
@media(max-width:700px){
  .group-grid { grid-template-columns: 1fr; }
  .cost-grid { grid-template-columns: 1fr; }
  .kpi-grid { grid-template-columns: 1fr; }
  .tools-grid { grid-template-columns: 1fr; }
  .phase { grid-template-columns: 48px 1fr; }
  .header-tabs { display: none; }
  .mobile-tabs {
    display: flex;
    overflow-x: auto;
    gap: 6px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--bg2);
  }
}
@media(min-width:701px){ .mobile-tabs { display: none; } }
</style>
</head>
<body>

<div class="header">
  <div class="header-brand">
    <div class="header-dot"></div>
    <div>
      <div class="header-title">Quy trình CTV Tuyển dụng</div>
      <div class="header-sub">Phòng Lao Động — Ban QLKKT Hải Phòng</div>
    </div>
  </div>
  <div class="header-tabs">
    <button class="tab-btn active" onclick="showSection('tong-quan')">Tổng quan</button>
    <button class="tab-btn" onclick="showSection('nhom-ctv')">Nhóm CTV</button>
    <button class="tab-btn" onclick="showSection('chi-phi')">Chi phí & thưởng</button>
    <button class="tab-btn" onclick="showSection('cong-cu')">Công cụ</button>
  </div>
</div>

<div class="mobile-tabs">
  <button class="tab-btn active" onclick="showSection('tong-quan')">Tổng quan</button>
  <button class="tab-btn" onclick="showSection('nhom-ctv')">Nhóm CTV</button>
  <button class="tab-btn" onclick="showSection('chi-phi')">Chi phí</button>
  <button class="tab-btn" onclick="showSection('cong-cu')">Công cụ</button>
</div>

<!-- ==================== TỔNG QUAN ==================== -->
<div id="tong-quan" class="section active">
<div class="container">
  <div class="pipeline-header">
    <h2>Vòng đời CTV — 6 giai đoạn</h2>
    <p>Nhấn vào từng giai đoạn để xem chi tiết · Quy trình tuần hoàn, không tuyến tính</p>
  </div>

  <div class="pipeline">

    <div class="phase v-purple">
      <div class="phase-connector">
        <div class="phase-num" onclick="openModal('m1')">1</div>
        <div class="phase-line"></div>
      </div>
      <div class="phase-label">
        <div class="phase-label-title">Tuyển CTV</div>
        <div class="phase-card" onclick="openModal('m1')">
          <h3>Tuyển CTV mới</h3>
          <p>Xác định nguồn, tiếp cận đúng nhóm, thu hút đăng ký</p>
          <div class="phase-steps">
            <span class="step-chip">Zalo OA / TikTok</span>
            <span class="step-chip">Giới thiệu CTV cũ</span>
            <span class="step-chip">Liên hệ nhà trường</span>
            <span class="step-chip">Phòng LĐ-TB&XH tỉnh</span>
          </div>
        </div>
      </div>
    </div>

    <div class="phase v-purple">
      <div class="phase-connector">
        <div class="phase-num" onclick="openModal('m2')">2</div>
        <div class="phase-line"></div>
      </div>
      <div class="phase-label">
        <div class="phase-label-title">Onboard</div>
        <div class="phase-card" onclick="openModal('m2')">
          <h3>Ký kết & Onboard</h3>
          <p>Hợp đồng, hướng dẫn nghiệp vụ, cấp tài liệu và thêm vào nhóm Zalo</p>
          <div class="phase-steps">
            <span class="step-chip">HĐ CTV cá nhân / Biên bản ký trường</span>
            <span class="step-chip">Nhóm Zalo</span>
            <span class="step-chip">Bộ tài liệu JD mẫu</span>
          </div>
        </div>
      </div>
    </div>

    <div class="phase v-teal">
      <div class="phase-connector">
        <div class="phase-num" onclick="openModal('m3')">3</div>
        <div class="phase-line"></div>
      </div>
      <div class="phase-label">
        <div class="phase-label-title">Giao việc</div>
        <div class="phase-card" onclick="openModal('m3')">
          <h3>Giao nhiệm vụ theo đợt</h3>
          <p>Nhận yêu cầu DN → soạn JD → phân phối đến đúng nhóm CTV trong ngày</p>
          <div class="phase-steps">
            <span class="step-chip">Nhận yêu cầu DN</span>
            <span class="step-chip">Soạn JD chuẩn</span>
            <span class="step-chip">Gửi 3 nhóm song song</span>
            <span class="step-chip">Chốt chỉ tiêu</span>
          </div>
        </div>
      </div>
    </div>

    <div class="phase v-teal">
      <div class="phase-connector">
        <div class="phase-num" onclick="openModal('m4')">4</div>
        <div class="phase-line"></div>
      </div>
      <div class="phase-label">
        <div class="phase-label-title">CTV hoạt động</div>
        <div class="phase-card" onclick="openModal('m4')">
          <h3>CTV hoạt động (3–14 ngày)</h3>
          <p>CTV lan truyền thông tin, lọc sơ bộ và gửi danh sách NLĐ về Trung tâm</p>
          <div class="phase-steps">
            <span class="step-chip">Share mạng xã hội</span>
            <span class="step-chip">Vận động tại địa phương</span>
            <span class="step-chip">Gửi danh sách NLĐ</span>
          </div>
        </div>
      </div>
    </div>

    <div class="phase v-amber">
      <div class="phase-connector">
        <div class="phase-num" onclick="openModal('m5')">5</div>
        <div class="phase-line"></div>
      </div>
      <div class="phase-label">
        <div class="phase-label-title">Nghiệm thu & Chi trả</div>
        <div class="phase-card" onclick="openModal('m5')">
          <h3>Nghiệm thu & Chi trả thưởng</h3>
          <p>Xác minh với DN → duyệt danh sách → chuyển khoản linh hoạt thương thảo</p>
          <div class="phase-steps">
            <span class="step-chip">Xác minh HR doanh nghiệp</span>
            <span class="step-chip">NLĐ đi làm ≥30 ngày</span>
            <span class="step-chip">Linh hoạt thương thảo</span>
          </div>
        </div>
      </div>
    </div>

    <div class="phase v-amber">
      <div class="phase-connector">
        <div class="phase-num" onclick="openModal('m6')">6</div>
        <div class="phase-line"></div>
      </div>
      <div class="phase-label">
        <div class="phase-label-title">Đánh giá</div>
        <div class="phase-card" onclick="openModal('m6')">
          <h3>Đánh giá & Phân loại lại hàng tháng</h3>
          <p>Chấm KPI → phân loại Chiến lược / Tiềm năng / Ngủ đông → xử lý từng nhóm</p>
          <div class="phase-steps">
            <span class="step-chip">Chiến lược → Tăng chỉ tiêu</span>
            <span class="step-chip">Tiềm năng → Kích hoạt</span>
            <span class="step-chip">Ngủ đông → Loại / Tuyển mới</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
</div>

<!-- ==================== NHÓM CTV ==================== -->
<div id="nhom-ctv" class="section">
